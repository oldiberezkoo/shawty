{
  "name": "shawty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm -r check",
    "dev:web": "pnpm --filter @shawty/web dev",
    "db:generate": "pnpm --filter @shawty/web db:generate",
    "db:migrate": "pnpm --filter @shawty/web db:migrate",
    "db:seed": "pnpm --filter @shawty/web db:seed",
    "db:reset": "pnpm --filter @shawty/web db:reset",
    "db:backup": "pnpm --filter @shawty/web db:backup",
    "db:reset-limits": "pnpm --filter @shawty/web db:reset-limits",
    "test:watch": "pnpm --filter @shawty/web test:watch",
    "test:integration": "pnpm --filter @shawty/web test:integration",
    "smoke:http": "pnpm --filter @shawty/web smoke:http",
    "smoke:pairing": "pnpm --filter @shawty/web smoke:pairing",
    "smoke:pages": "pnpm --filter @shawty/web smoke:pages",
    "smoke:pair-code": "pnpm --filter @shawty/web smoke:pair-code",
    "smoke:schedule": "pnpm --filter @shawty/web smoke:schedule"
  }
}
