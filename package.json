{
  "name": "shawty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm -r check",
    "dev:web": "pnpm --filter @shawty/web dev",
    "dev:api": "pnpm --filter @shawty/api dev",
    "db:generate": "pnpm --filter @shawty/api db:generate",
    "db:migrate": "pnpm --filter @shawty/api db:migrate",
    "db:seed": "pnpm --filter @shawty/api db:seed",
    "db:reset": "pnpm --filter @shawty/api db:reset",
    "db:backup": "pnpm --filter @shawty/api db:backup",
    "db:reset-limits": "pnpm --filter @shawty/api db:reset-limits",
    "test:watch": "pnpm --filter @shawty/api test:watch",
    "test:integration": "pnpm --filter @shawty/api test:integration",
    "smoke:http": "pnpm --filter @shawty/api smoke:http",
    "smoke:pairing": "pnpm --filter @shawty/api smoke:pairing",
    "smoke:pages": "pnpm --filter @shawty/api smoke:pages",
    "smoke:pair-code": "pnpm --filter @shawty/api smoke:pair-code",
    "smoke:schedule": "pnpm --filter @shawty/api smoke:schedule"
  }
}
